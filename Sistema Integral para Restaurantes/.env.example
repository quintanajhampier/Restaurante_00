# Firebase Web SDK - configuración pública (no son secretos)
# Estos valores son seguros para el frontend según la documentación de Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Variables EXCLUSIVAS del servidor (nunca en el frontend)
# Firebase Admin SDK
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_PROJECT_ID=
#
# Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#
# Culqi / Pasarela de pagos
# CULQI_PRIVATE_KEY=
# CULQI_PUBLIC_KEY=
#
# Webhooks
# CULQI_WEBHOOK_SECRET=
